# Supabase Configuration for TruckSaathi
# Replace these with your actual Supabase project URL and anon public key from Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Production Site URL (Used as fallback when window.location.origin is unavailable, e.g. during SSR)
# In production on Vercel set: NEXT_PUBLIC_SITE_URL=https://truck-saathi.vercel.app
NEXT_PUBLIC_SITE_URL=https://truck-saathi.vercel.app

# Google Maps API Key for Fleet & Driver Telematics Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=AIzaSyAOVYRIgupAurZup5y1PRh8Ismb1A3lLao
